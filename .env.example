# AURA — environment configuration (example)
# Copy to `.env.local` (or `.env`) and fill in keys. Never commit real keys.
# All values here are empty placeholders — the studio runs fully in demo mode
# when no keys are set.

# ─── LLM Director (quick-goal box + /api/orchestrate) ─────────────────────
# OpenAI drives the autonomous Director agent loop when set. Absent => the
# Deterministic Creative Director runs the pipeline instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ─── Image generation ───────────────────────────────────────────────────────
# OpenAI gpt-image-1 is the locked primary image provider per
# .context/system.md §7, §45. Replicate is a secondary alternative.
# FAL_KEY is intentionally NOT used — it's dormant (see bottom).
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# ─── Video generation ───────────────────────────────────────────────────────
# Google Veo 3 is preferred (GOOGLE_API_KEY / GEMINI_API_KEY). The provider
# chain follows the priority in src/lib/providers/config.ts.
GOOGLE_API_KEY=
GEMINI_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=
REPLICATE_API_TOKEN=

# ─── Voice (PRIMARY TTS; OpenAI is the alternative) ─────────────────────────
# Speechify TTS via the official `@speechify/api` SDK (client.audio.speech).
# Speechify is the primary voice provider — when SPEECHIFY_API_KEY is set it
# takes priority over OpenAI TTS. Optionally pin a voice id with
# SPEECHIFY_VOICE and a model with SPEECHIFY_MODEL (default `simba-3.2`;
# use `simba-3.0` for multilingual / non-English voices).
SPEECHIFY_API_KEY=
SPEECHIFY_VOICE=
SPEECHIFY_MODEL=simba-3.2

# ─── Supabase (durable production state) ────────────────────────────────────
# Required for Vercel deploys. Without these, the studio still works in
# local-only mode — every Supabase write is best-effort and logs a single
# warn if the client can't be built.
#
# Rotate the service-role key at Supabase → Project Settings → API.
# The publishable key is safe in the browser; the service-role key is
# NEVER exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ─── Cloudflare R2 (persistent media store) ─────────────────────────────────
# Required for Vercel deploys so generated media survives across cold
# starts. Without R2_* env vars, the studio falls back to writing under
# /public/assets/ — fine for local dev, broken for serverless.
#
# Rotate at Cloudflare → R2 → Manage R2 API Tokens. The Access Key ID +
# Secret are NEVER exposed to the browser.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: stable custom-domain URL for artifact delivery. When unset,
# asset URLs are signed (presigned GET, 1h expiry) instead.
# R2_PUBLIC_URL=https://media.your-domain.com

# ─── Demo mode ──────────────────────────────────────────────────────────────
# When DEMO_MODE=true (default), /api/generate/* returns a placeholder
# asset if the matching provider key isn't set, so the studio stays runnable
# without paid accounts. Set DEMO_MODE=false in production to return 503 when
# a key is missing — callers will know the response is not a real asset.
#
# For a judge-safe live demo, set DEMO_MODE=enforced: every provider selector
# is forced to `demo` (a dead-man switch) so a deployed instance can never
# bill a real provider, regardless of what keys are present.
DEMO_MODE=true

# ─── Server ─────────────────────────────────────────────────────────────────
# Dev server runs on 3010 (3000/3001/3002 are used by other local nodes).
PORT=3010
# Public origin the server uses when calling its own /api/generate/* routes.
# Defaults to http://localhost:PORT when unset.
# STUDIO_PUBLIC_URL=

# ─── FAL_KEY (dormant) ───────────────────────────────────────────────────────
# Per .context/system.md §45, fal.ai is intentionally NOT in the studio's
# primary provider chain. The lines below are kept as dormant references
# in case a future deployment opts back in; they are NOT read by any
# active code path. DO NOT uncomment without re-reading §45.
# FAL_KEY=
# FAL_VIDEO_MODEL=fal-ai/kling-video/v1/standard/image-to-video
# FAL_T2V_MODEL=fal-ai/kling-video/v1/standard/text-to-video
# FAL_IMAGE_MODEL=fal-ai/nano-banana

